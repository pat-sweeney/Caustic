// File: SSAO.ps
//
// Ground Truth Ambient Occlusion (GTAO) implementation.
// Uses horizon-based angle integration in screen space for
// physically-based AO with multi-scale occlusion support.
// Reconstructs view-space positions using the actual projection
// matrix rather than hardcoded FOV/near/far.
//**********************************************************************
Texture2D sceneTexture : register(t0);
SamplerState sceneSampler : register(s0);
Texture2D depthTexture : register(t1);
SamplerState depthSampler : register(s1);

struct VSOutput
{
    float4 posPS : SV_POSITION;
    float2 uvs : TEXCOORD0;
};

cbuffer PS_CONSTANT_BUFFER
{
    float screenWidth;
    float screenHeight;
    float aoRadius;
    float aoIntensity;
    float aoFalloff;
    float3 padding;
    float4x4 projMatrix;
};

static const float c_PI = 3.14159265;
static const int c_NumDirections = 8;
static const int c_NumSteps = 4;

float LinearizeDepth(float d)
{
    float z = projMatrix._43 / (d - projMatrix._33);
    return z;
}

float3 ReconstructViewPos(float2 uv, float depth)
{
    float linearZ = LinearizeDepth(depth);
    float cx = uv.x * 2.0 - 1.0;
    float cy = (1.0 - uv.y) * 2.0 - 1.0;
    float viewX = cx * linearZ / projMatrix._11;
    float viewY = cy * linearZ / projMatrix._22;
    return float3(viewX, viewY, linearZ);
}

float3 ReconstructNormal(float2 uv, float2 texelSize)
{
    float dC = depthTexture.SampleLevel(depthSampler, uv, 0).r;
    float dR = depthTexture.SampleLevel(depthSampler, uv + float2(texelSize.x, 0.0), 0).r;
    float dD = depthTexture.SampleLevel(depthSampler, uv + float2(0.0, texelSize.y), 0).r;
    float dL = depthTexture.SampleLevel(depthSampler, uv - float2(texelSize.x, 0.0), 0).r;
    float dU = depthTexture.SampleLevel(depthSampler, uv - float2(0.0, texelSize.y), 0).r;

    float3 posC = ReconstructViewPos(uv, dC);

    float3 ddx_val = (abs(dR - dC) < abs(dC - dL))
        ? ReconstructViewPos(uv + float2(texelSize.x, 0.0), dR) - posC
        : posC - ReconstructViewPos(uv - float2(texelSize.x, 0.0), dL);
    float3 ddy_val = (abs(dD - dC) < abs(dC - dU))
        ? ReconstructViewPos(uv + float2(0.0, texelSize.y), dD) - posC
        : posC - ReconstructViewPos(uv - float2(0.0, texelSize.y), dU);

    return normalize(cross(ddy_val, ddx_val));
}

float SpatialNoise(float2 pixelCoord)
{
    return frac(sin(dot(pixelCoord, float2(12.9898, 78.233))) * 43758.5453);
}

float GTAO(float2 uv, float3 viewPos, float3 viewNormal, float2 texelSize)
{
    float projScale = projMatrix._22 * screenHeight * 0.5;
    float screenRadius = (aoRadius * projScale) / viewPos.z;
    screenRadius = max(screenRadius, 3.0);
    screenRadius = min(screenRadius, min(screenWidth, screenHeight) * 0.5);

    float stepSize = screenRadius / (float)c_NumSteps;
    float noise = SpatialNoise(uv * float2(screenWidth, screenHeight));

    float totalAO = 0.0;

    for (int dir = 0; dir < c_NumDirections; dir++)
    {
        float angle = (c_PI / (float)c_NumDirections) * ((float)dir + noise);
        float2 direction = float2(cos(angle), sin(angle)) * texelSize;

        float maxAnglePos = -c_PI;
        float maxAngleNeg = -c_PI;

        for (int step = 1; step <= c_NumSteps; step++)
        {
            float2 offset = direction * (float)step * stepSize;

            float2 sUVP = uv + offset;
            if (sUVP.x >= 0.0 && sUVP.x <= 1.0 && sUVP.y >= 0.0 && sUVP.y <= 1.0)
            {
                float sdP = depthTexture.SampleLevel(depthSampler, sUVP, 0).r;
                if (sdP < 1.0)
                {
                    float3 hVec = ReconstructViewPos(sUVP, sdP) - viewPos;
                    float dist = length(hVec);
                    float fo = saturate(1.0 - pow(dist / aoRadius, aoFalloff));
                    float ha = atan2(hVec.z, length(hVec.xy));
                    maxAnglePos = max(maxAnglePos, ha * fo);
                }
            }

            float2 sUVN = uv - offset;
            if (sUVN.x >= 0.0 && sUVN.x <= 1.0 && sUVN.y >= 0.0 && sUVN.y <= 1.0)
            {
                float sdN = depthTexture.SampleLevel(depthSampler, sUVN, 0).r;
                if (sdN < 1.0)
                {
                    float3 hVec = ReconstructViewPos(sUVN, sdN) - viewPos;
                    float dist = length(hVec);
                    float fo = saturate(1.0 - pow(dist / aoRadius, aoFalloff));
                    float ha = atan2(hVec.z, length(hVec.xy));
                    maxAngleNeg = max(maxAngleNeg, ha * fo);
                }
            }
        }

        float3 sliceDir = float3(cos(angle), sin(angle), 0.0);
        float3 projNormal = viewNormal - sliceDir * dot(viewNormal, sliceDir);
        float projNormalLen = length(projNormal);
        float normalAngle = atan2(projNormal.z, length(projNormal.xy));

        float h1 = max(maxAngleNeg, normalAngle);
        float h2 = max(maxAnglePos, normalAngle);
        float inner = 0.25 * (-cos(2.0 * h1 - normalAngle) + cos(normalAngle) +
                               2.0 * h1 * sin(normalAngle));
        inner += 0.25 * (-cos(2.0 * h2 - normalAngle) + cos(normalAngle) +
                          2.0 * h2 * sin(normalAngle));

        totalAO += projNormalLen * inner;
    }

    totalAO /= (float)c_NumDirections;
    return saturate(totalAO);
}

float4 PS(VSOutput p) : SV_Target
{
    float2 texelSize = float2(1.0 / screenWidth, 1.0 / screenHeight);
    float depth = depthTexture.SampleLevel(depthSampler, p.uvs, 0).r;

    if (depth >= 1.0)
    {
        float3 scene = sceneTexture.Sample(sceneSampler, p.uvs).rgb;
        return float4(scene, 1.0);
    }

    float3 viewPos = ReconstructViewPos(p.uvs, depth);
    float3 viewNormal = ReconstructNormal(p.uvs, texelSize);

    float ao = GTAO(p.uvs, viewPos, viewNormal, texelSize);
    ao = pow(ao, aoIntensity);

    float3 scene = sceneTexture.Sample(sceneSampler, p.uvs).rgb;
    return float4(scene * ao, 1.0);
}
