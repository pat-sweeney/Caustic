// File: BloomExtract.ps
//
// Bright-pass extraction shader for bloom. Extracts pixels above
// a luminance threshold from the HDR scene buffer.
//**********************************************************************
Texture2D tex : register(t0);
SamplerState s : register(s0);

struct VSOutput
{
    float4 posPS : SV_POSITION;
    float2 uvs : TEXCOORD0;
};

cbuffer PS_CONSTANT_BUFFER
{
    float threshold;
};

float4 PS(VSOutput p) : SV_Target
{
    float3 color = tex.Sample(s, p.uvs).rgb;
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float3 bloom = color * max(luminance - threshold, 0.0) / (luminance + 0.0001);
    return float4(bloom, 1.0);
}
