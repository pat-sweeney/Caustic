// File: SSAOBlur.ps
//
// Bilateral blur for SSAO. Smooths the noisy AO result while
// preserving depth discontinuities to avoid halo artifacts.
//**********************************************************************
Texture2D tex : register(t0);
SamplerState s : register(s0);

struct VSOutput
{
    float4 posPS : SV_POSITION;
    float2 uvs : TEXCOORD0;
};

cbuffer PS_CONSTANT_BUFFER
{
    float texelWidth;
    float texelHeight;
};

float4 PS(VSOutput p) : SV_Target
{
    float2 texelSize = float2(texelWidth, texelHeight);
    float3 result = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;

    float3 centerColor = tex.Sample(s, p.uvs).rgb;
    float centerLum = dot(centerColor, float3(0.2126, 0.7152, 0.0722));

    // 5x5 bilateral blur
    [unroll]
    for (int x = -2; x <= 2; x++)
    {
        [unroll]
        for (int y = -2; y <= 2; y++)
        {
            float2 offset = float2(float(x), float(y)) * texelSize;
            float3 sampleColor = tex.Sample(s, p.uvs + offset).rgb;
            float sampleLum = dot(sampleColor, float3(0.2126, 0.7152, 0.0722));

            // Bilateral weight: spatial * range
            float spatial = exp(-float(x * x + y * y) / 4.5);
            float range = exp(-abs(centerLum - sampleLum) * 20.0);
            float weight = spatial * range;

            result += sampleColor * weight;
            totalWeight += weight;
        }
    }

    return float4(result / totalWeight, 1.0);
}
