// File: SSAOBlur.ps
//
// Depth-aware bilateral blur for GTAO. Smooths the AO result while
// preserving depth discontinuities and geometric edges.
//**********************************************************************
Texture2D tex : register(t0);
SamplerState s : register(s0);
Texture2D depthTexture : register(t1);
SamplerState depthSampler : register(s1);

struct VSOutput
{
    float4 posPS : SV_POSITION;
    float2 uvs : TEXCOORD0;
};

cbuffer PS_CONSTANT_BUFFER
{
    float texelWidth;
    float texelHeight;
    float depthThreshold;
    float padding;
};

float4 PS(VSOutput p) : SV_Target
{
    float2 texelSize = float2(texelWidth, texelHeight);
    float3 result = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;

    float3 centerColor = tex.Sample(s, p.uvs).rgb;
    float centerDepth = depthTexture.SampleLevel(depthSampler, p.uvs, 0).r;

    // 5x5 bilateral blur with depth-aware weighting
    [unroll]
    for (int x = -2; x <= 2; x++)
    {
        [unroll]
        for (int y = -2; y <= 2; y++)
        {
            float2 offset = float2(float(x), float(y)) * texelSize;
            float2 sampleUV = p.uvs + offset;
            float3 sampleColor = tex.Sample(s, sampleUV).rgb;
            float sampleDepth = depthTexture.SampleLevel(depthSampler, sampleUV, 0).r;

            // Spatial weight (Gaussian)
            float spatial = exp(-float(x * x + y * y) / 4.5);

            // Depth weight: reject samples across depth discontinuities
            float depthDiff = abs(centerDepth - sampleDepth);
            float depthWeight = exp(-depthDiff * depthDiff / (depthThreshold * depthThreshold));

            float weight = spatial * depthWeight;
            result += sampleColor * weight;
            totalWeight += weight;
        }
    }

    return float4(result / max(totalWeight, 0.0001), 1.0);
}
